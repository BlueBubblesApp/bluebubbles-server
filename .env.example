SPARKLE_EDDSA_PRIVATE_KEY=
SPARKLE_PUBLIC_KEY=
BB_VM_SHARE=

# License issuer. Not vendor-named on purpose: which processor the Worker talks to is its
# business, and the whole point of Tools/license-worker is that changing one touches nothing
# else. See that directory's README.
BB_LICENSE_WORKER=
BB_TEST_LICENSE_KEY=

# Creem, for hitting the vendor directly rather than through the Worker. The Worker keeps its
# own copy as a Cloudflare secret (`wrangler secret put CREEM_API_KEY`); this is a shell
# convenience and must never be given to the server or the app.
CREEM_API_KEY=
CREEM_API_BASE=https://test-api.creem.io
